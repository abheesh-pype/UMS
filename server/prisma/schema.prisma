generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String?                @unique
  phone                 String?
  address               String?
  contactEmail          String?
  contactPhone          String?
  plan                  String?
  slug                  String?                @unique
  logo                  String?
  status                String?                @default("active")
  licenseId             String?
  licenseExpiry         DateTime?
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              AdmissionSession[]
  announcements         Announcement[]
  attendances           Attendance[]
  auditLogs             AuditLog[]
  branches              Branch[]
  ceoPanels             CeoPanel[]
  complaints            Complaint[]
  credentialRequests    CredentialRequest[]
  departments           Department[]
  designations          Designation[]
  editDeleteRequests    EditDeleteRequest[]
  employees             Employee[]
  employeeProfiles      EmployeeProfile[]
  enrollments           Enrollment[]
  escalations           Escalation[]
  escalationLogs        EscalationLog[]
  expenseClaims         ExpenseClaim[]
  feeStructures         FeeStructure[]
  gstSettings           GSTSetting[]
  studentFeeReceipts    StudentFeeReceipt[]
  hrSettings            HRSettings?
  holidays              Holiday[]
  incentiveStructures   IncentiveStructure[]
  internalMarks         InternalMark[]
  invoices              Invoice[]
  leads                 Lead[]
  leaveAllocations      LeaveAllocation[]
  leaveRequests         LeaveRequest[]
  notifications         Notification[]
  license               License?               @relation(fields: [licenseId], references: [id])
  payments              PaymentEntry[]
  payrolls              Payroll[]
  payrollBatches        PayrollBatch[]
  polls                 Poll[]
  programs              Program[]
  modules               Module[]
  semesters             Semester[]
  examinations          Examination[]
  examinationRegistrations ExaminationRegistration[]
  programMaterials      ProgramMaterial[]
  programAllocations    ProgramAllocation[]
  universityAllocations UniversityAllocation[]
  programFeeStructures  ProgramFeeStructure[]
  referralLinks         ReferralLink[]
  reregRules            ReregRule[]
  salaryConfigs         SalaryConfig[]
  sessionReqs           SessionRequest[]
  students              Student[]
  studyCenters          StudyCenter[]
  studyCenterInvites    StudyCenterInvite[]
  centerWallets         StudyCenterWallet[]
  subDepartments        SubDepartment[]
  targets               Target[]
  tasks                 Task[]
  universities          University[]
  authFees              UniversityAuthFee[]
  users                 User[]
  universityFeePayments UniversityFeePayment[]
  vacancies             Vacancy[]
  walletTopUps          WalletTopUp[]
  studentStatusRequests StudentStatusRequest[]
  commissionIns         CommissionIn[]
  commissionOuts        CommissionOut[]
  hiringRequests        HiringRequest[]
  candidates            Candidate[]
  shifts                Shift[]

  @@index([status])
}

model License {
  id             String         @id @default(uuid())
  name           String
  type           String?
  features       Json           @default("[]")
  maxUsers       Int            @default(10)
  maxStorage     Int            @default(1024)
  durationMonths Int            @default(12)
  price          Float
  status         String         @default("active")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizations  Organization[]
}

model Department {
  id                 String          @id @default(uuid())
  organizationId     String
  name               String
  type               String?
  subType            String?
  parentDepartmentId String?
  managerId          String?
  features           Json?           @default("[]")
  permissions        Json?           @default("[]")
  status             String          @default("active")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  announcements      Announcement[]
  additionalBranches Branch[]        @relation("BranchAdditionalDepts")
  opsBranch          Branch?         @relation("BranchOpsDept")
  salesBranch        Branch?         @relation("BranchSalesDept")
  manager            User?           @relation("DepartmentManager", fields: [managerId], references: [id])
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment   Department?     @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]    @relation("DepartmentHierarchy")
  designations       Designation[]
  leaveRequests      LeaveRequest[]
  subDepartments     SubDepartment[]
  targets            Target[]
  tasks              Task[]
  users              User[]          @relation("UserToDepartment")
  vacancies          Vacancy[]
  assistantManagers  User[]          @relation("AssistantManagers")
  hiringRequests     HiringRequest[]

  @@index([organizationId, type])
  @@index([organizationId, status])
}

model User {
  id                            String                 @id @default(uuid())
  userId                        String?                @unique
  organizationId                String?
  departmentId                  String?
  additionalDepartmentIds       String[]
  branchId                      String?
  subDepartmentId               String?
  ceoPanelId                    String?
  studyCenterId                 String?
  universityId                  String?
  email                         String                 @unique
  password                      String
  name                          String
  role                          String?
  avatar                        String?
  phone                         String?
  designation                   String?
  reportingTo                   String?
  status                        String?                @default("active")
  lastLogin                     DateTime?
  designationId                 String?
  canAddPrograms                Boolean                @default(false)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  approvedSessions              AdmissionSession[]     @relation("SessionApprovedBy")
  createdSessions               AdmissionSession[]     @relation("SessionCreatedBy")
  postedAnnouncements           Announcement[]
  attendances                   Attendance[]
  auditLogs                     AuditLog[]
  managedBranch                 Branch?                @relation("BranchManager")
  ceoPanel                      CeoPanel?
  complaints                    Complaint[]
  credentialResponder           CredentialRequest[]    @relation("CredentialResponder")
  credentialRequester           CredentialRequest[]    @relation("CredentialRequester")
  managedDepartments            Department[]           @relation("DepartmentManager")
  editDeleteResponder           EditDeleteRequest[]    @relation("EditDeleteResponder")
  editDeleteRequester           EditDeleteRequest[]    @relation("EditDeleteRequester")
  employeeProfile               Employee?
  employeeProfileDetail         EmployeeProfile?
  deptReviewedEnrollments       Enrollment[]           @relation("DeptReviewedBy")
  financeReviewedEnrollments    Enrollment[]           @relation("FinanceReviewedBy")
  universityReviewedEnrollments Enrollment[]           @relation("UniversityReviewedBy")
  salesLedEnrollments           Enrollment[]           @relation("SalesUserEnrollments")
  studentFeeReceipts            StudentFeeReceipt[]
  deptAdminEscalations          Escalation[]           @relation("EscalationDeptAdmin")
  employeeEscalations           Escalation[]           @relation("EscalationEmployee")
  handledEscalations            Escalation[]           @relation("EscalationHandledBy")
  resolvedEscalations           Escalation[]           @relation("EscalatedResolvedBy")
  approvedExpenseClaims         ExpenseClaim[]         @relation("ExpenseApprovedBy")
  expenseClaims                 ExpenseClaim[]         @relation("EmployeeExpenses")
  createdGstSettings            GSTSetting[]           @relation("GstSettingCreatedBy")
  approvedIncentives            IncentiveStructure[]   @relation("IncentiveApprovedBy")
  createdIncentives             IncentiveStructure[]   @relation("IncentiveCreatedBy")
  enteredMarks                  InternalMark[]         @relation("MarkEnteredBy")
  referredLeads                 Lead[]                 @relation("LeadReferredBy")
  createdLeaveAllocations       LeaveAllocation[]      @relation("LeaveAllocationCreatedBy")
  leaveAllocations              LeaveAllocation[]
  deptApprovedLeaves            LeaveRequest[]         @relation("DeptApprovedBy")
  leaveRequests                 LeaveRequest[]         @relation("EmployeeLeaves")
  hrApprovedLeaves              LeaveRequest[]         @relation("HrApprovedBy")
  notifications                 Notification[]
  receivedPayments              PaymentEntry[]         @relation("PaymentReceivedBy")
  confirmedPayrolls             Payroll[]              @relation("PayrollConfirmedBy")
  payrolls                      Payroll[]              @relation("EmployeePayroll")
  financeApprovedPayrolls       Payroll[]              @relation("PayrollFinanceApprovedBy")
  processedPayrolls             Payroll[]              @relation("PayrollProcessedBy")
  transferredPayrolls           Payroll[]              @relation("PayrollTransferredBy")
  batchApproved                 PayrollBatch[]         @relation("BatchApprovedBy")
  batchRejected                 PayrollBatch[]         @relation("BatchRejectedBy")
  batchTransferred              PayrollBatch[]         @relation("BatchTransferredBy")
  createdPolls                  Poll[]                 @relation("PollCreatedBy")
  programAllocations            ProgramAllocation[]    @relation("AllocatedBy")
  universityAllocations         UniversityAllocation[] @relation("UniAllocatedBy")
  createdProgramFees            ProgramFeeStructure[]  @relation("ProgramFeeCreatedBy")
  referralLink                  ReferralLink?
  salaryApproved                SalaryConfig[]         @relation("SalaryApprovedBy")
  salaryCreated                 SalaryConfig[]         @relation("SalaryCreatedBy")
  salaryConfig                  SalaryConfig?          @relation("UserSalaryConfig")
  approvedRequests              SessionRequest[]       @relation("RequestApprovedBy")
  sessionRequests               SessionRequest[]
  studentProfile                Student?
  examinationRegistrations      ExaminationRegistration[]
  referredStudents              Student[]              @relation("StudentReferredBy")
  financeApprovedCenters        StudyCenter[]          @relation("FinanceApprovedBy")
  referredStudyCenters          StudyCenter[]          @relation("ReferredBy")
  assignedOperationsCenters      StudyCenter[]          @relation("OperationsCenterAssignee")
  assignedFinanceCenters        StudyCenter[]          @relation("FinanceCenterAssignee")
  verifiedStudyCenters          StudyCenter[]          @relation("VerifiedBy")
  studyCenterInvites            StudyCenterInvite[]    @relation("InviteReferredBy")
  managedSubDepartments         SubDepartment[]        @relation("SubDeptManager")
  targets                       Target[]               @relation("TargetEmployee")
  assignedTasks                 Task[]                 @relation("AssignedTasks")
  createdTasks                  Task[]                 @relation("CreatedTasks")
  escalatedTasks                Task[]                 @relation("EscalatedTasks")
  configuredAuthFees            UniversityAuthFee[]    @relation("AuthFeeConfiguredBy")
  uploadedMaterials             ProgramMaterial[]      @relation("MaterialUploader")
  branch                        Branch?                @relation(fields: [branchId], references: [id])
  department                    Department?            @relation("UserToDepartment", fields: [departmentId], references: [id])
  organization                  Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager                       User?                  @relation("ReportingChain", fields: [reportingTo], references: [id])
  subordinates                  User[]                 @relation("ReportingChain")
  studyCenter                   StudyCenter?           @relation("CenterAdmin", fields: [studyCenterId], references: [id])
  subDepartment                 SubDepartment?         @relation(fields: [subDepartmentId], references: [id])
  university                    University?            @relation("UniversityAdmin", fields: [universityId], references: [id])
  verifiedWalletTopUps          WalletTopUp[]          @relation("TopUpVerifiedBy")
  assistantManagedDepartments   Department[]           @relation("AssistantManagers")
  designationRef                Designation?           @relation("DesignationToUsers", fields: [designationId], references: [id])
  requestedHirings              HiringRequest[]        @relation("HiringRequestedBy")
  approvedHirings               HiringRequest[]        @relation("HiringApprovedBy")
  inductionsCompleted           Candidate[]            @relation("InductionCompletedBy")

  @@index([organizationId, role])
  @@index([departmentId])
}

model Employee {
  id             String       @id @default(uuid())
  userId         String       @unique
  organizationId String
  employeeId     String       @unique
  joinDate       DateTime     @default(now())
  salary         Float?
  vacancyId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Task {
  id               String           @id @default(uuid())
  organizationId   String
  title            String
  description      String
  assignedTo       String
  createdBy        String
  departmentId     String?
  targetDate       DateTime?
  priority         TaskPriority     @default(medium)
  status           TaskStatus       @default(pending)
  deadline         DateTime
  completedAt      DateTime?
  evidence         Json             @default("[]")
  remarks          String?
  escalatedTo      String?
  escalatedAt      DateTime?
  escalationStatus EscalationStatus @default(none)
  gracePeriodEnd   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  escalations      Escalation[]
  assignee         User             @relation("AssignedTasks", fields: [assignedTo], references: [id])
  assigner         User             @relation("CreatedTasks", fields: [createdBy], references: [id])
  department       Department?      @relation(fields: [departmentId], references: [id])
  escalatedUser    User?            @relation("EscalatedTasks", fields: [escalatedTo], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([assignedTo, status])
  @@index([organizationId, departmentId])
  @@index([deadline, status])
}

model Attendance {
  id                  String           @id @default(uuid())
  userId              String           @map("employeeId")
  organizationId      String
  date                DateTime
  status              AttendanceStatus
  checkIn             DateTime?
  checkOut            DateTime?
  checkInLocation     Json?
  checkOutLocation    Json?
  isLate              Boolean          @default(false)
  lateMinutes         Int              @default(0)
  workingHours        Float            @default(0)
  isHalfDay           Boolean          @default(false)
  isWFH               Boolean          @default(false)
  lateDeductionAmount Float?           @default(0)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([isLate])
}

model University {
  id                    String                 @id @default(uuid())
  organizationId        String
  subDepartmentId       String?
  name                  String
  code                  String
  address               String?
  contact               String?
  country               String?
  coordinatorName       String?
  status                String                 @default("active")
  category              String                 @default("team_lease") // "team_lease", "direct_iits", "premium"
  optionalFields        Json?                  @default("{}")
  admissionSessions     AdmissionSession[]
  programs              Program[]
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authFees              UniversityAuthFee[]
  admins                User[]                 @relation("UniversityAdmin")
  assignedSubDepts      SubDepartment[]        @relation("SubDeptToUniversity")
  allowedBranches       Branch[]               @relation("UniversityToBranch")
  studyCenters          StudyCenter[]          @relation("UniversityToStudyCenter")
  programFeeStructures  ProgramFeeStructure[]
  universityAllocations UniversityAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Program {
  id                      String                @id @default(uuid())
  universityId            String
  organizationId          String
  academicSessionId       String?
  subDepartmentId         String?
  name                    String
  courseName              String?
  description             String?
  code                    String
  courseType              CourseType            @default(OnlineDegree)
  duration                Int
  hasSemesters            Boolean               @default(false)
  semesters               Json                  @default("[]")
  specialisations         Json                  @default("[]")
  certificateRequirements Json?                 @default("[]")
  isDeleted               Boolean               @default(false)
  status                  String                @default("active")
  admissionSessions       AdmissionSession[]
  enrollments             Enrollment[]
  materials               ProgramMaterial[]
  modules                 Module[]
  semesterRecords         Semester[]
  examinations            Examination[]
  feeStructure            FeeStructure?
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicSession         AdmissionSession?     @relation("AcademicSessionPrograms", fields: [academicSessionId], references: [id])
  university              University            @relation(fields: [universityId], references: [id])
  programAllocations      ProgramAllocation[]
  programFeeStructure     ProgramFeeStructure[]
  reregRules              ReregRule[]
  students                Student[]
  studyCenters            StudyCenter[]         @relation("ProgramToStudyCenter")
  assignedSubDepts        SubDepartment[]       @relation("SubDeptToProgram")

  @@index([universityId])
  @@index([organizationId])
}

model Module {
  id                String            @id @default(uuid())
  organizationId    String
  programId         String
  academicSessionId String?
  moduleCode        String
  moduleName        String
  moduleType        String
  semesterId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program           Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicSession   AdmissionSession? @relation(fields: [academicSessionId], references: [id])
  semester          Semester?         @relation(fields: [semesterId], references: [id])

  @@unique([programId, moduleCode])
  @@index([organizationId])
  @@map("modules")
}

model Semester {
  id                String           @id @default(uuid())
  organizationId    String
  programId         String
  academicSessionId String
  semesterName      String
  semesterNumber    Int
  startDate         DateTime
  endDate           DateTime
  status            String           @default("active")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program           Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicSession   AdmissionSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  modules           Module[]
  examinations      Examination[]

  @@unique([programId, semesterNumber])
  @@index([organizationId])
  @@index([programId])
  @@map("semester")
}

model Examination {
  id                String           @id @default(uuid())
  organizationId    String
  academicSessionId String
  programId         String
  semesterId        String
  examinationName   String
  examinationType   String
  startDate         DateTime
  endDate           DateTime
  description       String?
  status            String           @default("draft")
  moduleIds         Json             @default("[]")
  schedule          Json             @default("[]")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicSession   AdmissionSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  program           Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester          Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  registrations     ExaminationRegistration[]

  @@index([organizationId])
  @@index([academicSessionId, programId, semesterId])
  @@map("examinations")
}

model ExaminationRegistration {
  id             String       @id @default(uuid())
  organizationId String
  examinationId  String
  studentId      String
  userId         String
  fullName       String
  enrollmentNo   String
  email          String
  phone          String
  confirmedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination    Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId])
  @@index([organizationId, examinationId])
}

model StudyCenter {
  id                     String                 @id @default(uuid())
  organizationId         String
  name                   String
  code                   String
  address                String?
  contact                String?
  email                  String?
  city                   String?
  state                  String?
  coordinatorName        String?
  status                 String                 @default("pending_verification")
  universityIds          String[]
  programIds             String[]
  pendingDocuments       Json                   @default("[]")
  referredBy             String?
  assignedOperationsUserId String?
  assignedFinanceUserId  String?
  inviteToken            String?
  verifiedBy             String?
  verifiedAt             DateTime?
  opsRemarks             String?
  financeApprovedBy      String?
  financeApprovedAt      DateTime?
  paymentRemarks         String?
  paymentProof           Json?
  credentials            Json?
  statusHistory          Json                   @default("[]")
  customEnrollmentFields Json?                  @default("[]")
  branchName             String?
  allowInternalMarks     Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  admissionSessions      AdmissionSession[]
  enrollments            Enrollment[]
  enrollmentPayments     EnrollmentPayment[]
  internalMarks          InternalMark[]
  invoices               Invoice[]
  programAllocations     ProgramAllocation[]
  universityAllocations  UniversityAllocation[]
  sessionRequests        SessionRequest[]
  students               Student[]
  approver               User?                  @relation("FinanceApprovedBy", fields: [financeApprovedBy], references: [id])
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer               User?                  @relation("ReferredBy", fields: [referredBy], references: [id])
  assignedOperationsUser User?                  @relation("OperationsCenterAssignee", fields: [assignedOperationsUserId], references: [id], onDelete: SetNull)
  assignedFinanceUser    User?                  @relation("FinanceCenterAssignee", fields: [assignedFinanceUserId], references: [id], onDelete: SetNull)
  verifier               User?                  @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  wallet                 StudyCenterWallet?
  targets                Target[]
  centerAdmins           User[]                 @relation("CenterAdmin")
  walletTopUps           WalletTopUp[]
  allowedPrograms        Program[]              @relation("ProgramToStudyCenter")
  assignedSubDepts       SubDepartment[]        @relation("SubDeptToCenter")
  associatedUniversities University[]           @relation("UniversityToStudyCenter")
  commissionOuts         CommissionOut[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Student {
  id                  String         @id @default(uuid())
  centerId            String?
  organizationId      String
  enrollmentNo        String         @unique
  uniEnrollmentNumber String?
  name                String
  email               String         @unique
  phone               String
  address             String
  programId           String
  sessionId           String?
  specialisation      String?
  abcId               String?
  debId               String?
  dob                 String?
  religion            String?
  caste               String?
  fatherName          String?
  motherName          String?
  parentMobile        String?
  studentPhoto        String?
  pincode             String?
  alternativePhone    String?
  maritalStatus       String?
  currentlyWorking    String?
  status              String         @default("pending")
  joinDate            DateTime       @default(now())
  enrolledAt          DateTime?
  reregStatus         Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  referredBy          String?
  enrollments         Enrollment[]
  internalMarks       InternalMark[]

  universityFeePayments UniversityFeePayment[] @relation("StudentUniFeePayments")
  invoices              Invoice[]
  center                StudyCenter?           @relation(fields: [centerId], references: [id])
  user                  User                   @relation(fields: [email], references: [email])
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program               Program                @relation(fields: [programId], references: [id])
  referrer              User?                  @relation("StudentReferredBy", fields: [referredBy], references: [id])
  statusRequests        StudentStatusRequest[]
  examinationRegistrations ExaminationRegistration[]

  @@index([organizationId, status])
  @@index([centerId])
  @@index([referredBy])
}

model Invoice {
  id             String         @id @default(uuid())
  organizationId String
  centerId       String?
  studentId      String?
  invoiceNo      String         @unique
  amount         Float
  tax            Float          @default(0)
  total          Float
  status         String         @default("draft")
  items          Json           @default("[]")
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  center         StudyCenter?   @relation(fields: [centerId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student?       @relation(fields: [studentId], references: [id])
  payments       PaymentEntry[]

  @@index([organizationId, status])
  @@index([centerId])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  centerName     String
  contactName    String?
  email          String
  phone          String
  address        String
  source         String
  referredBy     String?
  status         String       @default("new")
  notes          String       @default("")
  convertedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer       User?        @relation("LeadReferredBy", fields: [referredBy], references: [id])

  @@index([organizationId, status])
  @@index([referredBy])
}

model Complaint {
  id             String            @id @default(uuid())
  organizationId String
  employeeId     String
  subject        String
  description    String
  category       String
  status         ComplaintStatus   @default(open)
  priority       ComplaintPriority @default(medium)
  submittedAt    DateTime          @default(now())
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId])
}

model Notification {
  id             String               @id @default(uuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           NotificationType     @default(general)
  priority       NotificationPriority @default(medium)
  read           Boolean              @default(false)
  link           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
