  @@unique([organizationId, centerId, programId])
}

model UniversityAllocation {
  id             String       @id @default(uuid())
  organizationId String
  centerId       String
  universityId   String
  allocatedBy    String
  allocatedAt    DateTime     @default(now())
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  allocatedByMgr User         @relation("UniAllocatedBy", fields: [allocatedBy], references: [id])
  center         StudyCenter  @relation(fields: [centerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  university     University   @relation(fields: [universityId], references: [id])

  @@unique([organizationId, centerId, universityId])
}

model ReferralLink {
  id             String       @id @default(uuid())
  organizationId String
  userId         String       @unique
  code           String       @unique
  clicks         Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReregRule {
  id             String       @id @default(uuid())
  organizationId String
  programId      String
  semester       Int
  rules          Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id])
}

model SessionRequest {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  details        Json
  status         String       @default("pending")
  centerId       String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approver       User?        @relation("RequestApprovedBy", fields: [approvedBy], references: [id])
  center         StudyCenter? @relation(fields: [centerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyCenterInvite {
  id             String       @id @default(uuid())
  organizationId String
  token          String       @unique
  universityIds  String[]
  programIds     String[]
  referredBy     String
  branchId       String?
  status         String       @default("pending")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer       User         @relation("InviteReferredBy", fields: [referredBy], references: [id])

  @@index([organizationId, referredBy])
}

model Target {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String?
  departmentId   String?
  centerId       String?
  type           String
  period         String
  target         Float
  achieved       Float        @default(0)
  incentive      Float?
  deadline       DateTime?
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  center         StudyCenter? @relation(fields: [centerId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
  employee       User?        @relation("TargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
  @@index([employeeId])
}

model UniversityAuthFee {
  id               String       @id @default(uuid())
  organizationId   String
  universityId     String
  feeDetails       Json
  configuredBy     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  configuredByUser User?        @relation("AuthFeeConfiguredBy", fields: [configuredBy], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  university       University   @relation(fields: [universityId], references: [id])

  @@unique([organizationId, universityId])
}

model FeeStructure {
  id              String       @id @default(uuid())
  programId       String       @unique
  organizationId  String
  registrationFee Float        @default(0)
  tuitionFee      Float        @default(0)
  examFee         Float        @default(0)
  otherCharges    Json         @default("{}")
  gstPercentage   Float        @default(18)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program         Program      @relation(fields: [programId], references: [id])

  @@index([organizationId])
}

model EnrollmentPayment {
  id            String            @id @default(uuid())
  enrollmentId  String            @unique
  studyCenterId String
  walletId      String
  amount        Float
  debitedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  enrollment    Enrollment        @relation(fields: [enrollmentId], references: [id])
  studyCenter   StudyCenter       @relation(fields: [studyCenterId], references: [id])
  wallet        StudyCenterWallet @relation(fields: [walletId], references: [id])

  @@index([studyCenterId])
}

model StudentFeeReceipt {
  id             String   @id @default(uuid())
  organizationId String
  enrollmentId   String
  amount         Float
  paymentMode    String
  referenceNo    String?
  receiptDate    DateTime @default(now())
  remarks        String?
  recordedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recorder     User         @relation(fields: [recordedBy], references: [id])

  @@index([enrollmentId])
  @@index([organizationId])
}

model IncentiveStructure {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  targetType     String
  applicableTo   String
  tiers          Json         @default("[]")
  period         String
  status         String       @default("draft")
  approvedBy     String?
  approvedAt     DateTime?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approver       User?        @relation("IncentiveApprovedBy", fields: [approvedBy], references: [id])
  creator        User         @relation("IncentiveCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model ProgramFeeStructure {
  id                 String            @id @default(uuid())
  level              String            @default("program") // "program" or "university"
  programId          String?
  universityId       String?
  admissionSessionId String?
  organizationId     String
  billingCycle       String
  baseFee            Float
  fullProgramFee     Float?            @default(0)
  universityFee      Float             @default(0)
  additionalFees     Json              @default("[]")
  feeBreakdown       Json              @default("[]")
  currency           String            @default("INR")
  commissionRate     Float             @default(0)
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  creator            User              @relation("ProgramFeeCreatedBy", fields: [createdBy], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program            Program?          @relation(fields: [programId], references: [id])
  university         University?       @relation(fields: [universityId], references: [id])
  admissionSession   AdmissionSession? @relation(fields: [admissionSessionId], references: [id])

  @@index([organizationId])
}

model UniversityFeePayment {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  enrollmentId   String?
  invoiceId      String?
  semesterOrYear String       @default("1")
  amount         Float
  status         String       @default("pending") // "pending", "paid"
  referenceNo    String?
  paidAt         DateTime?
  screenshot     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  student        Student      @relation("StudentUniFeePayments", fields: [studentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
}

model ProgramMaterial {
  id             String       @id @default(uuid())
  programId      String
  organizationId String
  title          String
  description    String?
  category       String       @default("study_material")
  semesterNumber String?
  fileUrl        String
  fileName       String
  uploadedBy     String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  program        Program      @relation(fields: [programId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader       User         @relation("MaterialUploader", fields: [uploadedBy], references: [id])

  @@index([programId])
  @@index([organizationId])
}

